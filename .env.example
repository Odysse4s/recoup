# Copy to .env and fill in active API keys. Never commit the real .env file.

# Reasoning LLM: fal | gemini | groq | openai | fake
LLM_PROVIDER=fal
FAL_LLM_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
LLM_CACHE=1
LLM_FALLBACK_FAKE=1

# Voice TTS, Grok Realtime WebSocket & Wizper STT via fal.ai
FAL_KEY=
FAL_TTS_MODEL=fal-ai/elevenlabs/tts/eleven-v3
FAL_STT_MODEL=fal-ai/wizper
FAL_VISION_MODEL=

# Oumi Iris System-1 Zero-Output-Token Decision Gate
OUMI_API_KEY=
OUMI_MODEL=projects/7HBTQDVH6J-24/models/iris-latest

# Runtime
WORKSPACE_DIR=./workspace
APPROVAL_TIMEOUT_S=300
