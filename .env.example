# Copy to backend/.env and fill in what you have. Never commit the real file.

# LLM: fake | gemini | groq | openai
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
LLM_CACHE=1
LLM_FALLBACK_FAKE=1

# Voice and vision via fal (model ids configurable)
FAL_KEY=
FAL_TTS_MODEL=
FAL_STT_MODEL=
FAL_VISION_MODEL=

# Wonderful voice agent platform
WONDERFUL_API_KEY=

# Oumi Iris System-1 Decision Model
OUMI_API_KEY=
OUMI_MODEL=projects/7HBTQDVH6J-24/models/iris-latest

# Runtime
WORKSPACE_DIR=./workspace
APPROVAL_TIMEOUT_S=300
